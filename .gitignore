**.DS_Store
.Rproj.user
.Rhistory
.RData
.Ruserdata
local/
inst/py/mosaic-python-env
model/LAUNCH.R
model/output/
/output/
**data_psi_suitability.csv
# Ignore claude/ CONTENTS rather than the directory itself, so git still descends
# into it and the negation below can take effect (git never re-includes a path
# under an excluded directory).
claude/*
# Exception: the psi 12-week evolution process ledger must be durable across
# sessions and machines (see claude/psi_evolve/PROTOCOL.md).
!claude/psi_evolve/
# ...but not its bulk artefacts: data backups, run logs and per-arm outputs are
# large and reproducible. Only the process ledger itself is tracked.
claude/psi_evolve/da01_backup/
claude/psi_evolve/*.log
claude/psi_evolve/results/
claude/psi_evolve/psi_cache/
*.tar.gz
*.Rcheck/
..Rcheck/
sbi-logs/
vignettes/cache/
vignettes/figures/
vignettes/articles/cache/
vignettes/articles/figures/
model/scenarios/
deprecated/
Rplots.pdf
*.bak
*.bak_*

# Python bytecode (e.g. compiled inst/python worker, created by source_python)
__pycache__/
*.pyc

.Rd2pdf*/

# Agent local (uncommitted) memory
.claude/agent-memory-local/

# Local secrets / credentials — never commit
.env
.env.*
*.env
.ssh/
*.pem
*_key
*_key.pub
